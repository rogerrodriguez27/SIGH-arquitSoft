# Plantilla de variables de entorno del SIGH.
# Copia este archivo con el nombre .env y completa los valores reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# --- APIPERU: consulta de DNI (fuente RENIEC) ---
ApiPeru__Token=
ApiPeru__BaseUrl=https://apiperu.dev/api

# --- Notificaciones push (Web Push con claves VAPID) ---
WebPush__PublicKey=
WebPush__PrivateKey=
WebPush__Subject=mailto:roger.rodriguez.27@unsch.edu.pe

# ===== Base de datos (PostgreSQL) =====
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sigh_oltp
ConnectionStrings__SighOltp=

# ===== Autenticación JWT =====
Jwt__ClaveFirma=
Jwt__Emisor=sigh-api
Jwt__Audiencia=sigh-web

# ===== CORS (origen del frontend) =====
Cors__OrigenPermitido=http://localhost:5173

# ===== Administrador inicial (solo primer arranque) =====
AdminInicial__Usuario=
AdminInicial__NombreCompleto=
AdminInicial__Contrasena=
