    "/api/v1/bitacora-accesos": {
      "get": {
        "tags": [
          "Bitacora"
        ],
        "summary": "Consulta la bitácora de accesos a la HCE (FR-024, FR-025) – permiso bitacora.consultar",
        "description": "Rango obligatorio de un año o menos. Resultados de la entrada más reciente a la más antigua. Cada consulta se registra como evento de seguridad BITACORA_CONSULTADA. Nunca incluye contenido clínico.",
        "parameters": [
          {
            "name": "desde",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "hasta",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "usuarioId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "historiaId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "accion",
            "in": "query",
            "schema": {
              "maxLength": 40,
              "type": "string"
            }
          },
          {
            "name": "resultado",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ResultadoAcceso"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaRespuestaOfEntradaBitacoraDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaRespuestaOfEntradaBitacoraDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaRespuestaOfEntradaBitacoraDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
