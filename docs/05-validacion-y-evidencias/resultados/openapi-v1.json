{
  "openapi": "3.1.1",
  "info": {
    "title": "SIGH – API del módulo Administración",
    "description": "Autenticación, usuarios, roles, matriz de permisos y bitácora de accesos a la HCE (spec 001-admin-auth-rbac). Todas las rutas exigen un JWT (Bearer) salvo iniciar-sesion. Los errores usan application/problem+json.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080/"
    }
  ],
  "paths": {
    "/api/v1/autenticacion/iniciar-sesion": {
      "post": {
        "tags": [
          "Autenticacion"
        ],
        "summary": "Inicia sesión (FR-001, FR-003, FR-004)",
        "description": "Devuelve un JWT de 30 minutos. Ante credenciales inválidas, usuario inexistente, desactivado o bloqueado responde 401 con el mismo mensaje genérico.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IniciarSesionSolicitud"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/IniciarSesionSolicitud"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/IniciarSesionSolicitud"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SesionRespuesta"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionRespuesta"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionRespuesta"
                }
              }
            }
          },
